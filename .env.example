# Paradigm Training Manager
#
# Local development defaults normally require no
# environment variables. Copy this file to .env only
# when you need explicit local overrides.

PTM_ENV=development

# Optional local override. If omitted, Flask uses
# backend/instance/ptm.db.
# DATABASE_URL=sqlite:///ptm.db

# Never commit a real production secret.
# SECRET_KEY=replace-with-a-random-secret

SESSION_COOKIE_SECURE=false

# Optional compiled frontend override.
# FRONTEND_DIST_DIR=/absolute/path/to/frontend/dist
